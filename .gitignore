# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc / OS junk
.DS_Store
Thumbs.db
desktop.ini
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# typescript build products
*.tsbuildinfo
next-env.d.ts

# author-local scratch files & tooling
/local-*
/test
/prompt
*.log
dev.log
dev.out.log
server.log
/.claude
/.z-ai-config

# editor state (machine-specific paths)
.vscode/

# Python bytecode
__pycache__/
*.pyc

# machine-local runtime data — run artifacts are never committed (SETUP.md)
attune-data/runs/

# standalone packaging output (scripts/standalone/package.sh + Release workflow)
/dist/

# one-time local kernel build — restorable via the build command in SETUP.md
/vendor/omnidecide-c/build/

# frozen golden replay-corpus (~12 MB) — not checked in; regenerate locally
# from the vendored source: tests/golden_tool.c (`build/golden_tool gen golden`)
/vendor/omnidecide-c/golden/

# vercel
.vercel
