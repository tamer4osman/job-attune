# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# testing
/coverage

# production
/build

# misc / OS junk
.DS_Store
Thumbs.db
desktop.ini
*.pem

# env files
.env*

# author-local scratch files & tooling
/local-*
/test
/prompt
*.log
dev.log
dev.out.log
server.log
/.claude
/.z-ai-config

# editor state (machine-specific paths)
.vscode/

# Python bytecode
__pycache__/
*.pyc

# machine-local runtime data - run artifacts are never committed (SETUP.md)
attune-data/runs/

# standalone packaging output (scripts/standalone/package.sh + Release workflow)
/dist/

# one-time local kernel build - restorable via the build command in SETUP.md
/vendor/omnidecide-c/build/

# frozen golden replay-corpus (~12 MB) - not checked in; regenerate locally
# from the vendored source: tests/golden_tool.c (`build/golden_tool gen golden`)
/vendor/omnidecide-c/golden/

# QA scratch output regenerated by every check_python_side.py run
/scripts/tmp_pycheck/
