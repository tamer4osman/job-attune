{
  "profile_name": "Furniture Technician (Assembly & Service) - Kantholz Einrichtungswerke GmbH, Berlin (case study)",
  "company": {
    "name": "Kantholz Einrichtungswerke GmbH, Berlin",
    "summary": "A mid-sized Berlin furniture company that produces and installs made-to-measure kitchens, fitted wardrobes and office furniture. Its assembly and service team works at private and commercial customer sites in two-person crews: installing, adjusting and repairing furniture, and representing the company directly in front of the customer.",
    "values_text": "safety; teamwork; quality; reliable; communication"
  },
  "job": {
    "title": "Furniture Technician (Assembly & Service)",
    "description": "You will install kitchens, fitted wardrobes and office furniture at customer sites in two-person teams, carry out furniture repair and adjustment service calls, work from assembly instructions and installation plans, measure on site (Aufmass), and represent the company in front of customers. The eligibility requirements follow the standard published for comparable furniture technician, furniture service technician and furniture installer positions (including Havertys Furniture Service Technician, Cushman & Wakefield Workplace Services Technician, and German Kuechen- und Moebelmonteur postings on the Bundesagentur fuer Arbeit job board, retrieved 2026-11-11): completed vocational training in carpentry or a comparable trade, proven furniture assembly experience, confident use of hand and power tools, ability to read assembly instructions and installation plans, a valid class B driver's licence, customer-facing service skills and good German for customer contact."
  },
