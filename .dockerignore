# Keep the build context small. The kernel build needs vendor/omnidecide-c
# and requirements.txt; the fullstack runtime bakes server.py, web/,
# attune-engine/, attune-sample-data/ and attune-data/templates/. Everything
# else stays host-side: the engine QA image bind-mounts the repo at /app
# (see Dockerfile header).
.git
.vscode

bench
docs
scripts

# Frozen golden corpus and the local kernel build tree stay out of the image
# context: ~12 MB of regenerable corpus plus machine-local build products
# (both restored/regenerated from source, see .gitignore)
vendor/omnidecide-c/golden
vendor/omnidecide-c/build

# Run artifacts are machine-local state - never baked into images
attune-data/runs

*.log
**/__pycache__
